<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HeadTracker.Core\HeadTracker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- FSA-Net smoke test needs the capsule model next to the test binaries. -->
    <Content Include="..\..\assets\fsanet_capsule.onnx" Link="fsanet_capsule.onnx" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
