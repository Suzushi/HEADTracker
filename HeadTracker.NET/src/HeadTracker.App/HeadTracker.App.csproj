<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\HeadTracker.Core\HeadTracker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Hardcodet.NotifyIcon.Wpf" Version="2.0.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Legacy config stays at the repo root; ship a copy next to the exe. -->
    <Content Include="..\..\..\config.yaml" Link="config.yaml" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\assets\**\*">
      <Link>assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Resource Include="..\..\..\icon.ico" Link="icon.ico" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>HeadTracker</AssemblyName>
    <!-- The authoritative version is the git tag: release.yml passes -p:Version=<tag minus the
         leading v>, and a global property beats anything set here. This prefix only shapes local
         builds, so that a dev exe reports something more useful than the SDK default 1.0.0 when a
         user pastes a crash.log — ProductVersion also carries the commit sha. Keep it equal to the
         last tag you cut. -->
    <VersionPrefix>0.2.0</VersionPrefix>
    <ApplicationIcon>..\..\..\icon.ico</ApplicationIcon>
    <!-- No <ApplicationManifest> on purpose: the app runs at whatever integrity level its caller
         has. It was briefly elevated to fix an in-game re-center hotkey that turned out to be a
         UI-thread starvation problem instead (see Services/GlobalHotkey.cs), and elevation costs
         every user a UAC prompt per launch plus a cross-integrity-level shared memory handle.
         If someone's game does run elevated, UIPI blocks the hotkey; crash.log records elevated=
         so that case stays diagnosable without paying for it up front. -->
  </PropertyGroup>

</Project>
