<Window x:Class="HeadTracker.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        xmlns:local="clr-namespace:HeadTracker.App"
        mc:Ignorable="d"
        Title="HeadTracker" Height="560" Width="960"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- Tray icon: app keeps tracking when the window is hidden. -->
        <tb:TaskbarIcon x:Key="TrayIcon"
                        IconSource="/icon.ico"
                        ToolTipText="HeadTracker"
                        TrayMouseDoubleClick="OnTrayShowClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="{DynamicResource tray_show}" Click="OnTrayShowClick" />
                    <MenuItem Header="{DynamicResource tray_toggle}" Click="OnTrayToggleClick" />
                    <MenuItem Header="{DynamicResource tray_recenter}" Click="OnTrayRecenterClick" />
                    <Separator />
                    <MenuItem Header="{DynamicResource tray_settings}" Click="OnTraySettingsClick" />
                    <MenuItem Header="{DynamicResource tray_exit}" Click="OnTrayExitClick" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="310" />
            </Grid.ColumnDefinitions>

            <!-- Camera preview with landmark overlay -->
            <Border Grid.Column="0" Background="Black" CornerRadius="4">
                <Grid>
                    <Image Source="{Binding Preview}" Stretch="Uniform" />
                    <TextBlock Text="{DynamicResource preview_hint}"
                               Foreground="Gray" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Preview}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- Side panel -->
            <ScrollViewer Grid.Column="1" Margin="8,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="HeadTracker" FontSize="20" FontWeight="Bold" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" Margin="0,0,0,8" />

                    <GroupBox Header="{DynamicResource group_perf}" Padding="4">
                        <TextBlock Text="{Binding PerfText}" FontFamily="Consolas" FontSize="12" />
                    </GroupBox>

                    <GroupBox Header="{DynamicResource group_output}" Padding="4" Margin="0,6,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding OutputPoseText}" FontFamily="Consolas" FontSize="12" />
                            <TextBlock Text="{Binding OutputTransText}" FontFamily="Consolas" FontSize="12" />
                        </StackPanel>
                    </GroupBox>

                    <GroupBox Header="{DynamicResource group_raw}" Padding="4" Margin="0,6,0,0">
                        <TextBlock Text="{Binding RawPoseText}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                    </GroupBox>

                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <Button Content="{DynamicResource btn_start}" Command="{Binding StartCommand}" Margin="0,0,3,6" Height="32" />
                        <Button Content="{DynamicResource btn_stop}" Command="{Binding StopCommand}" Margin="3,0,0,6" Height="32" />
                        <Button Content="{DynamicResource btn_recenter}" Command="{Binding RecenterCommand}" Margin="0,0,3,6" Height="32" />
                        <Button Content="{DynamicResource btn_settings}" Command="{Binding OpenSettingsCommand}" Margin="3,0,0,6" Height="32" />
                        <ToggleButton Content="{Binding MirrorButtonText}" IsChecked="{Binding MirrorOn}" Margin="0,0,3,6" Height="32"
                                      ToolTip="{DynamicResource mirror_tooltip}" />
                        <Button Content="{DynamicResource btn_restart_camera}" Command="{Binding RestartCameraCommand}" Margin="3,0,0,6" Height="32"
                                ToolTip="{DynamicResource btn_restart_camera_tip}" />
                    </UniformGrid>

                    <TextBlock Foreground="Gray" FontSize="11" TextWrapping="Wrap" Margin="0,2,0,0"
                               Text="{DynamicResource hotkeys_hint}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <StatusBar Grid.Row="1">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusText}" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
