    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="hotkey_reg_failed">Global re-center hotkey {0} failed to register (Win32 error {1}) — 1409 means another program already holds it; pick a different combination in Settings. The in-window C key still re-centers.</system:String>

