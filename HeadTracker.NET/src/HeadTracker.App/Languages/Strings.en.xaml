    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="tab_fusion">Fusion &amp; Hotkeys</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="tab_mapping">Mapping</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="tab_smoothing">Smoothing</system:String>

    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_language">UI language</system:String>
