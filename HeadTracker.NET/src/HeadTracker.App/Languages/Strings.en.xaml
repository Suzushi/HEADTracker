    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_camera_id_tip">Pick a detected camera; the leading number is the device index used to open it.</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_camera_refresh">Refresh</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_camera_unavailable">Camera {0} (not connected)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_camera_fallback">Camera {0}</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_mirror">Mirror image (front cam)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_fps">Target fps</system:String>
