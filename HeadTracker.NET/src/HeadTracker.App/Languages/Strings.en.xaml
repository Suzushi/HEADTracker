    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_redetect">Re-detect every N frames</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_landmark_model">Landmark model</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="lm_0">0 — fastest (112px)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="lm_1">1 — fast (112px)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="lm_2">2 — balanced (224px)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="lm_3">3 — accurate (224px)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="lm_4">4 — most accurate (224px)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_roi_smooth">ROI smoothing rate</system:String>

    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_use_ft">FreeTrack shared memory</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_npclient">npclient (TrackIR)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_send_udp">Send UDP pose data</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_udp_host">UDP host</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_udp_port">UDP port</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="dcs_note">DCS World: enable FreeTrack shared memory, then in DCS set Head Tracking to TrackIR. No other software (e.g. opentrack) needs to run.</system:String>

    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_use_ekf">EKF fusion (use_ekf)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_use_fsa">FSA-Net 2nd measurement</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_ekf_dt">EKF predict dt (s)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_pitch_offset">FSA↔PnP pitch offset (deg)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_recenter_hotkey">Re-center hotkey</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_recenter_hotkey_tip">Format: Ctrl+X, Ctrl+Alt+X, or a bare F-key like F13. Registered globally and handled on its own thread, so it works while the game has focus; change it here if it clashes with another app. If the game itself runs as administrator, start HeadTracker as administrator too — otherwise Windows (UIPI) blocks the hotkey.</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="fusion_note">The re-center hotkey above is registered globally and handled on a dedicated thread, so it keeps working while a CPU-saturating sim holds the foreground. It does need HeadTracker to run at least as elevated as the game: Windows (UIPI) blocks hotkeys sent to a lower-integrity process. FSA-Net fusion requires EKF to be enabled.</system:String>

    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="map_col_x">X / Yaw</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="map_col_y">Y / Pitch</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="map_col_z">Z / Roll</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="map_inp_bound_m">Input bound (m)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="map_out_bound_m">Output bound (m)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="map_expo_m">Expo (0..1)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="map_invert_m">Invert direction</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="map_inp_bound_deg">Input bound (deg)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="map_out_bound_deg">Output bound (deg)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="map_expo_deg">Expo (0..1)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="map_invert_deg">Invert direction</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="map_note">Rotation rows are Yaw / Pitch / Roll. Head movement beyond the input bound saturates at the output bound. Ticking "Invert direction" flips the direction this axis is sent to the game; if an axis moves the wrong way in-game, tick it.</system:String>

    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="sm_use">Use Accela filter</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="sm_double">Double filter pass</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="sm_rot_smooth">Rotation smoothing</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="sm_rot_dz">Rotation deadzone (deg)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="sm_pos_smooth">Translation smoothing</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="sm_pos_dz">Translation deadzone (m)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="sm_oe_use">Use One-Euro adaptive low-pass</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="sm_oe_min_cutoff">Rotation cutoff at rest (Hz)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="sm_oe_beta">Rotation speed beta</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="sm_oe_deriv_cutoff">Derivative cutoff (Hz)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="sm_oe_pos_min_cutoff">Translation cutoff at rest (Hz)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="sm_oe_pos_beta">Translation speed beta</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="sm_oe_note">One-Euro filters the raw head angles and translation, ahead of the mapping gain: a lower cutoff is steadier and removes more at-rest jitter but lags more when you turn, while a higher beta follows fast motion with less lag and passes more jitter. Rotation and translation use different units (deg/s versus m/s), so tune them separately.</system:String>

    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="btn_save">Save &amp; Apply</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="btn_saving">Applying...</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_invalid_number">'{0}' is not a valid number, so nothing was saved. Fix the field outlined in red and try again.</system:String>
