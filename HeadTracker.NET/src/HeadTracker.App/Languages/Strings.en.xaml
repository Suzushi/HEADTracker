    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="btn_ok">OK</system:String>

    <!-- ============ calibration wizard ============ -->
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_calibration">Camera calibration...</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="set_calibration_note">Measure your camera's real intrinsics and lens distortion with a printed ChArUco board. Saved to config.yaml and used by the pose solver.</system:String>

    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_title">Camera calibration</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_need_board">Print the board and hold it in front of the camera. Live corner detection is shown here.</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_intro">Capture the printed ChArUco board from several angles (5+ samples, tilted and offset), then calibrate and save. Keep the board flat and fully visible.</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_print_board">1. Save printable board (PNG)</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_capture">2. Capture sample</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_samples_none">No samples yet</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_do_calibrate">3. Calibrate</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_save">Save &amp; Apply</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_clear">Clear saved calibration</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_close">Close</system:String>

    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_camera_failed">Could not open the camera. Close any other app using it, then reopen the wizard.</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_corners_ok">ChArUco corners detected: {0} — move the board to a new angle and capture.</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_corners_none">Corners detected: {0} — hold the printed board fully inside the frame.</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_board_saved">Board saved. Print it at 100% scale (disable fit-to-page).</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_sample_item">Sample #{0}: {1} corners</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_samples">Samples captured: {0}</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_capture_failed">Capture failed — not enough corners. Hold the board steady and fully visible.</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_result_ok">Calibration OK — RMS {0:F3}, fx {1:F0}, fy {2:F0}. Save to apply.</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_result_fail">Calibration failed: {0}</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_saved">Calibration saved to config.yaml. Restart tracking to apply.</system:String>
    <system:String xmlns:system="clr-namespace:System;assembly=mscorlib" x:Key="calib_cleared">Saved calibration cleared — reverting to default intrinsics.</system:String>

