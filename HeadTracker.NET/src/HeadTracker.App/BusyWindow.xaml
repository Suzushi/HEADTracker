<Window x:Class="HeadTracker.App.BusyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="HeadTracker" WindowStyle="None" ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" Topmost="True">
    <Border BorderBrush="Gray" BorderThickness="1" Padding="24,18" Background="White">
        <StackPanel Width="380">
            <ProgressBar IsIndeterminate="True" Height="16" />
            <TextBlock Text="{DynamicResource busy_negotiating}" TextWrapping="Wrap" Margin="0,12,0,0" />
        </StackPanel>
    </Border>
</Window>
