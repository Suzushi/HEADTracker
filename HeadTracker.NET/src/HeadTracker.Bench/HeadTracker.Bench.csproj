<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\HeadTracker.Core\HeadTracker.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\assets\**\*">
      <Link>assets\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Legacy config stays at the repo root; ship a copy next to the exe. -->
    <Content Include="..\..\..\config.yaml" Link="config.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
